# 对外域名（不含协议）与完整 URL；本地试跑保持 localhost 即可
PUBLIC_HOST=mcp.example.com
PUBLIC_URL=https://mcp.example.com

# 必填：Bearer token，可逗号分隔多个（每个使用方一个，便于单独吊销）。生成：openssl rand -hex 32
MCP_AUTH_TOKENS=

# 可选
MCP_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=60

# webtool
WEBTOOL_EXTRAS=all            # 或 rerank,crawl4ai 等，减小镜像
WEBTOOL_PROXY=                # 例如 http://host.docker.internal:7897（CN 网络下访问 DuckDuckGo 需要）
WEBTOOL_MAX_CONCURRENCY=2
WEBTOOL_PRELOAD=0             # 1=启动时预加载 cross-encoder（约 37s），避免首个请求冷启动
BRAVE_API_KEY=

# ---- 第三方（docker-compose.third-party.yml）----
COMPOSE_PROFILES=markitdown,excel,time    # 想启用哪些：markitdown,docling,excel,duckdb,time,chart,browser
EXCEL_INTERNAL_TOKEN=                     # excel 服务启用时必填：Caddy 用它替换用户 token 访问上游
MCP_BROWSER_TOKENS=                       # browser 专用通道 token（与 MCP_AUTH_TOKENS 互不通用）；不启用 browser 就留空
VIS_REQUEST_SERVER=                       # chart 启用时必填：私有渲染服务地址；或明确填公网 https://antv-studio.alipay.com/api/gpt-vis
CHART_DISABLED_TOOLS=                     # 例如 generate_district_map,generate_pin_map,generate_path_map
